{
  "functions": {
    "app.py": {
      "runtime": "python3.9",
      "maxDuration": 60
    }
  },
  "routes": [
    { "src": "/api/(.*)", "dest": "app.py" },
    { "src": "/proxy/(.*)", "dest": "app.py" },
    { "src": "/radio/(.*)", "dest": "app.py" },
    { "src": "/(.*)", "dest": "app.py" }
  ]
}




